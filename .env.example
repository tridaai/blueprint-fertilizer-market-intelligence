# Model port — the profile is resolved at startup and fails closed:
# an unknown profile refuses the boot, and a hosted profile selected
# without its key/endpoint refuses loudly at wiring time. There is no
# silent fallback to another profile, ever.
#   offline    deterministic, no network, no key (default; tests/evals)
#   anthropic  hosted frontier model via the Anthropic Messages API
#   bedrock    hosted frontier model via Amazon Bedrock
#   nim        OpenAI-compatible endpoint (e.g. NVIDIA NIM)
FERT_MODEL_PROFILE=offline
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# BEDROCK_MODEL_ID=
# AWS_REGION=us-east-1
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_API_KEY=
# NIM_MODEL=

# Local defaults work with everything below unset (SQLite store in
# ./data — the development profile). Set DATABASE_URL for the
# production-shaped profile: Postgres 16 is the system of record
# (docker-compose sets this for the app service).
# DATABASE_URL=postgresql://fert:fert@localhost:5432/fert
FERT_SQLITE_PATH=./data/fert.db

# Object storage for generated dashboard artefacts (later rounds;
# SeaweedFS in docker-compose, service name `minio`).
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=fert-artefacts

LOG_LEVEL=INFO
